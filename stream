#!/usr/bin/env bash
# 直播菜单:每次进入(启动/播放结束)并行探测各直播源在线状态并显示在菜单中;
# 播放结束后返回菜单,只有输入 q 才退出。VOD(点播)类型不探测。
# 状态は色分け: Live=緑 / VOD=シアン / 再生不可=灰 / 判定不能=黄。
SCRIPT="$HOME/bin/huya.sh"
RADIO_SCRIPT="$HOME/bin/cz_radio.sh"
YT_SCRIPT="$HOME/bin/yt_random.sh"
NHK_SCRIPT="$HOME/bin/nhk_radio.sh"
YNT_SCRIPT="$HOME/bin/ynt_radio.sh"
UA="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36"
RADIO_REF="https://radio5.cn/play/radio/czbtv-traffic-music-radio"
# NHKワールド・ラジオ日本(日本語): r1 主源, media2 备用
NHK_URLS=(
  "https://masterpl.hls.nhkworld.jp/hls/r1/live/master.m3u8"
  "https://nhkworld-radio.nhkworld.jp/hls/live/nhkworld-radio-media2/index.m3u8"
)
# ゆめのたね放送局 六色频道: 0) 的二级菜单(1-6)で選局する
YNT_URL_BASE="https://d2kz66ab55q61t.cloudfront.net"
YNT_KEYS=(red orange yellow green blue purple)
YNT_NAMES=(レッド オレンジ イエロー グリーン ブルー パープル)
YNT_COLORS=($'\033[38;5;196m' $'\033[38;5;208m' $'\033[38;5;220m' $'\033[38;5;46m' $'\033[38;5;33m' $'\033[38;5;135m')
COLOR_RESET=$'\033[0m'
COLOR_LIVE=$'\033[1;32m'      # 再生可(Live)
COLOR_VOD=$'\033[1;36m'       # 再生可(VOD)
COLOR_OFF=$'\033[2;37m'       # 再生不可
COLOR_UNKNOWN=$'\033[1;33m'   # 判定不能

# 並び: 生放送(ゲーム→ラジオ→ニュース) → VOD(日本語学習)
NAMES=("不求人" "Suk" "雨果" "晚玉阿" "清宁" "M（A妹）" "PEL和平精英赛事" "潮州交通音乐广播FM91.4" "NHKワールド・ラジオ日本" "TBS NEWS DIG(24hニュース)" "Japanese Everyday(おまかせ日本語)" "Japanese Girls Interview(おまかせ)" "Jiro, just Japanese" "Bite size Japanese" "Akiko_Japanese_Conversations(おまかせ)")
# 探测目标:huya:<房间号> / douyin:<web_rid> / radio / nhk / ytlive:<動画ID> / vod(不探测)
KEYS=(douyin:933572413882 huya:791120 huya:52009 douyin:401770194155 douyin:618168030518 douyin:856781106190 huya:660006 radio nhk ytlive:Anr15FA9OCI vod vod vod vod vod)
# 9番目以降のカナ選択肢(9→あ, 10→い, 11→う, 12→え, 13→お, 14→か)
KANA=(あ い う え お か)

probe_huya() { # $1=房间号
  local out
  out=$(curl -sL --compressed --max-time 6 -A "$UA" "https://www.huya.com/$1" \
        | grep -aoE 'liveStatus-(on|off)' | head -1)
  case "$out" in
    liveStatus-on)  echo "やってる" ;;
    liveStatus-off) echo "まだやってない" ;;
    *)              echo "わからない" ;;
  esac
}

probe_douyin() { # $1=web_rid
  local st
  st=$(curl -sL --compressed --max-time 6 -A "$UA" "https://live.douyin.com/$1" \
       | grep -aoE '\\"status_str\\":\\"[0-9]+' | head -1 | grep -aoE '[0-9]+$')
  case "$st" in
    2)  echo "やってる" ;;   # 2=直播中
    "") echo "わからない" ;;
    *)  echo "まだやってない" ;; # 4=已结束 等
  esac
}

probe_radio() {
  local h ck page nonce url code
  h=$(TZ=Asia/Shanghai date +%-H)
  if [ -n "$h" ] && [ "$h" -ge 1 ] && [ "$h" -lt 6 ]; then
    echo "お休み"; return   # 北京时间 01:00-06:00 官方源停播
  fi
  ck=$(mktemp)
  page=$(curl -s --max-time 6 -c "$ck" -A "$UA" "$RADIO_REF")
  nonce=$(grep -oE '"nonce":"[a-f0-9]+"' <<<"$page" | head -1 | cut -d'"' -f4)
  url=$(curl -s --max-time 6 -b "$ck" -A "$UA" -H "X-WP-Nonce: $nonce" -H "Referer: $RADIO_REF" \
        "https://radio5.cn/api/play/play/1719?type=post" \
        | python3 -c "import sys,json;print(json.load(sys.stdin).get('stream_url',''))" 2>/dev/null)
  rm -f "$ck"
  if [ -z "$url" ]; then echo "つながらない"; return; fi
  code=$(curl -s --max-time 5 --max-filesize 8192 -o /dev/null -w '%{http_code}' "$url")
  [ "$code" = 200 ] && echo "やってる" || echo "つながらない"
}

probe_nhk() {
  local u
  for u in "${NHK_URLS[@]}"; do
    [ "$(curl -s -o /dev/null -w '%{http_code}' --max-time 8 -A "$UA" "$u")" = 200 ] && { echo "やってる"; return; }
  done
  echo "つながらない"
}

probe_ytlive() { # $1=動画ID (YouTube ライブ)
  local st
  st=$(curl -sL --compressed --max-time 8 -A "$UA" "https://www.youtube.com/watch?v=$1" \
       | python3 -c '
import sys, re, json
h = sys.stdin.read()
m = re.search(r"\"videoDetails\"\s*:", h)
if not m or not h.strip():
    print("unknown"); raise SystemExit
i = m.end()
while i < len(h) and h[i] in " \t\r\n": i += 1
try:
    d, _ = json.JSONDecoder().raw_decode(h, i)
    print("live" if d.get("isLive") else "notlive")
except Exception:
    print("unknown")
' 2>/dev/null)
  case "$st" in
    live)    echo "やってる" ;;
    notlive) echo "まだやってない" ;;   # 配信終了・未開始・通常動画
    *)       echo "わからない" ;;
  esac
}

probe_ynt() { # 六色チャンネルのどれかが配信中なら「やってる」
  local d ch
  d=$(mktemp -d)
  for ch in "${YNT_KEYS[@]}"; do
    ( [ "$(curl -s --max-time 6 --max-filesize 8192 -o /dev/null -w '%{http_code}' -A "$UA" \
        "$YNT_URL_BASE/$ch")" = 200 ] && touch "$d/up" ) &
  done
  wait
  if [ -e "$d/up" ]; then echo "やってる"; else echo "つながらない"; fi
  rm -rf "$d"
}

probe_status() {
  case "$1" in
    huya:*)   probe_huya   "${1#huya:}" ;;
    douyin:*) probe_douyin "${1#douyin:}" ;;
    radio)    probe_radio ;;
    nhk)      probe_nhk ;;
    ytlive:*) probe_ytlive "${1#ytlive:}" ;;
  esac
}

status_color() { # $1=状態 → 色コード
  case "$1" in
    やってる)   printf '%s' "$COLOR_LIVE" ;;
    わからない) printf '%s' "$COLOR_UNKNOWN" ;;
    *)          printf '%s' "$COLOR_OFF" ;;
  esac
}

build_labels() {
  local d key i st
  d=$(mktemp -d)
  for key in "${KEYS[@]}"; do
    [ "$key" = vod ] && continue
    probe_status "$key" > "$d/${key//:/_}" &
  done
  probe_ynt > "$d/ynt" &   # 0) ゆめのたね放送局(六色のいずれか)
  wait
  LABELS=()
  for i in "${!NAMES[@]}"; do
    key="${KEYS[$i]}"
    if [ "$key" = vod ]; then
      LABELS+=("${COLOR_VOD}${NAMES[$i]} [VOD]${COLOR_RESET}")   # VOD 类型:不探测、VOD 色
    else
      st=$(cat "$d/${key//:/_}" 2>/dev/null)
      [ -z "$st" ] && st="わからない"
      LABELS+=("$(status_color "$st")${NAMES[$i]} [$st]${COLOR_RESET}")
    fi
  done
  YNT_LABEL=$(cat "$d/ynt" 2>/dev/null)
  [ -z "$YNT_LABEL" ] && YNT_LABEL="わからない"
  YNT_COLOR=$(status_color "$YNT_LABEL")
  rm -rf "$d"
}

choose_yumenotane() { # 0) ゆめのたね放送局: 六色から選局して再生
  local reply i
  while :; do
    echo "ゆめのたね放送局のチャンネル:"
    for i in "${!YNT_NAMES[@]}"; do
      printf ' %d) %s%s%s\n' "$((i + 1))" "${YNT_COLORS[$i]}" "${YNT_NAMES[$i]}" "$COLOR_RESET"
    done
    read -r -p "どの色にする? (q で戻る): " reply
    case "$reply" in
      [1-6]) "$YNT_SCRIPT" "${YNT_KEYS[$((reply - 1))]}"; return ;;
      q|Q) return ;;
      "") ;;
      *) echo "そんなのないよ" ;;
    esac
  done
}

PS3="どれにする? (q でやめる): "
while :; do
  echo "どれがやってるか見てみるね..."
  build_labels
  while :; do
    for i in "${!LABELS[@]}"; do
      if [ "$i" -ge 9 ]; then
        printf ' %s) %s\n' "${KANA[$((i - 9))]}" "${LABELS[$i]}"
      else
        printf ' %d) %s\n' "$((i + 1))" "${LABELS[$i]}"
      fi
      [ "$i" -eq 8 ] && printf ' 0) ゆめのたね放送局(色を選ぶ) %s[%s]%s\n' "$YNT_COLOR" "$YNT_LABEL" "$COLOR_RESET"
    done
    read -r -p "$PS3" REPLY
    case "$REPLY" in
      [1-9]|0|あ|a|A|い|i|I|う|u|U|え|e|E|お|o|O|か|k|K|q|Q) break ;;
      "") ;;
      *) echo "そんなのないよ" ;;
    esac
  done
  case "$REPLY" in
    1) "$SCRIPT" "https://live.douyin.com/933572413882" best ;;
    2) "$SCRIPT" "huya.com/791120" best "2385:1080" \
         '--vf=lavfi=[split=2[a][b];[a]scale=2385:1080[x];[b]crop=334:188:0:892,scale=415:234[c];[x][c]overlay=0:846]' ;;
    3) "$SCRIPT" "huya.com/52009" best ;;
    4) "$SCRIPT" "https://live.douyin.com/401770194155" best ;;
    5) "$SCRIPT" "https://live.douyin.com/618168030518" best ;;
    6) "$SCRIPT" "https://live.douyin.com/856781106190" best ;;
    7) "$SCRIPT" "huya.com/660006" best ;;
    8) "$RADIO_SCRIPT" ;;
    9) "$NHK_SCRIPT" ;;
    0) choose_yumenotane ;;
    あ|a|A) "$SCRIPT" "https://www.youtube.com/watch?v=Anr15FA9OCI" best ;;
    い|i|I) "$YT_SCRIPT" "https://www.youtube.com/@JapaneseEveryday" ;;
    う|u|U) "$YT_SCRIPT" "https://www.youtube.com/@Japanesegirlsinterview" ;;
    え|e|E) "$YT_SCRIPT" "https://www.youtube.com/@JiroJapanese" ;;
    お|o|O) "$YT_SCRIPT" "https://www.youtube.com/channel/UCc8QJqwkWe9RcKYZTY2Ezuw" ;;
    か|k|K) "$YT_SCRIPT" "https://www.youtube.com/@Aki-SenseiJPN" ;;
    q|Q) exit 0 ;;
  esac
  # 播放结束(或二级菜单返回) → 外层循环继续,重新探测并显示菜单
done
